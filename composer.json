{
    "name": "epay-et/php-sdk",
    "description": "Official ePay Business API client for PHP, with a Laravel integration.",
    "type": "library",
    "keywords": [
        "epay",
        "payments",
        "ethiopia",
        "telebirr",
        "cbe",
        "payment-gateway",
        "laravel"
    ],
    "homepage": "https://github.com/epay-et/php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "ePay",
            "homepage": "https://epayethiopia.com"
        }
    ],
    "support": {
        "issues": "https://github.com/epay-et/php-sdk/issues",
        "source": "https://github.com/epay-et/php-sdk",
        "docs": "https://github.com/epay-et/php-sdk#readme"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider and middleware (^10.0|^11.0)."
    },
    "autoload": {
        "psr-4": {
            "Epay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Epay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Epay\\Laravel\\EpayServiceProvider"
            ],
            "aliases": {
                "Epay": "Epay\\Laravel\\EpayFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
